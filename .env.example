# ── Trestle (CoreLogic) RESO Web API — MLS listing feed ──────────────────────
# Get credentials at https://trestle.corelogic.com → API Connections.
# Without these set, the site falls back to the static sample listings.
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=

# The brokerage's office MLS id(s), comma-separated if more than one board.
# The server-side query is office-scoped; results are then narrowed to the
# agent by DRE (below).
TRESTLE_OFFICE_MLS_ID=

# The agent's CA DRE license digits. Optional — defaults to the DRE in
# src/config/agent.ts. Set only to override without a code change.
# TRESTLE_AGENT_DRE=

# Optional override; defaults to https://api-prod.corelogic.com/trestle
# TRESTLE_API_BASE=

# ── Contact-form lead notifications ─────────────────────────────────────────
# Resend (https://resend.com) API key — sends the lead emails.
RESEND_API_KEY=
# Where leads go, comma-separated. e.g. jamie@realifirealty.com,josh@joshuaspooner.com
LEAD_TO_EMAILS=
# Fallback recipients if LEAD_TO_EMAILS is unset.
ALERT_TO_EMAILS=
# Optional custom sender (requires a verified domain in Resend).
# ALERT_FROM_EMAIL=Jamie Tian <leads@jamietian.com>
